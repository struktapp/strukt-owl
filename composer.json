{
    "name": "strukt/owl",
    "description": "Explainable AI and NLP utilities with a CLI, built on the Strukt math primitives.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "strukt/console": "v2.0.0",
        "strukt/math": "v1.0.0"
    },
    "require-dev": {
        "pestphp/pest": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Strukt\\Owl\\": "src/Strukt/Owl/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/owl"
    ],
    "scripts": {
        "test": "pest",
        "lint": "find src bin tests -name '*.php' -print0 | xargs -0 -n1 php -l"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "authors": [
        {
            "name": "pitsolu",
            "email": "pitsolu@gmail.com"
        }
    ],
    "version": "1.0.0"
}
